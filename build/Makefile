src/Presentation/ImGuiApp.s: src/Presentation/ImGuiApp.cpp.s
.PHONY : src/Presentation/ImGuiApp.s

# target to generate assembly for a file
src/Presentation/ImGuiApp.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\App.dir\build.make CMakeFiles/App.dir/src/Presentation/ImGuiApp.cpp.s
.PHONY : src/Presentation/ImGuiApp.cpp.s

